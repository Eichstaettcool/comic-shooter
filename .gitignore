# ============================================================
# comic-shooter - .gitignore (v1.58)
# Im Repo liegt NUR das Spiel: project/, screenshots/, README,
# LICENSE, CHANGELOG, CREDITS, Export-Skripte.
# Arbeitsdateien (Plaene, Specs, Berichte, Messlogs, Werkzeuge)
# bleiben lokal.
# ============================================================

# ---------- Engine und Export-Templates ----------
/Godot.exe
/Godot_v*-console.exe
/Godot.zip
/godot*.zip
*.pck

# ---------- Godot-Importcache ----------
project/.godot/
**/.godot/

# ---------- Builds ----------
dist/
build/
/*.zip
/*.tar.gz
*.apk
*.aab
*.idsig
*.exe
*.dmg
*.app/
project/ComicShooter*.apk
project/ComicShooter*.exe

# ---------- iOS/macOS-Exporte ----------
ios_build*/
ios_v*/
ios_*_package/
*.xcframework/
MoltenVK.xcframework/
*.xcodeproj/
*.xcworkspace/
*.ipa
*.mobileprovision
PrivacyInfo.xcprivacy

# ---------- Arbeitsdateien: Plaene, Specs, Berichte ----------
PLAN*.md
STATUS.md
SPEC_*.md
iOS-*.md
project/*.md
project/docs/
project/research/

# ---------- Messbelege, Werkzeuge, Golden-Referenzen ----------
logs_*.log
*.log
/tools/
backup/
repo/
project/screenshots/
/*.sh
compare/
cache/
scratch/
data/
*.py

# ---------- Screenshots: nur die fertigen Bilder ----------
screenshots/_alt/
screenshots/v*/
screenshots/*raw*
screenshots/*tmp*
screenshots/*-touch*
screenshots/*.html

# ---------- temporaer/abgeleitet ----------
*.tmp
*.bak
*.bak[0-9]*
STATUS.md.bak*
STATUS.md.v*
STATUS.md.neu
*.orig
*.rej
.DS_Store
Thumbs.db
desktop.ini

# ---------- Editor/IDE ----------
.vscode/
.idea/
*.swp
*~

# ---------- Python ----------
__pycache__/
*.pyc
.venv/
venv/

# ---------- Zugangsdaten (nie hochladen) ----------
.env
.env.*
*.keystore
*.jks
debug.keystore

# ---------- GitHub Actions (iOS-Workflow nur lokal) ----------
.github/
